def _carrega_config():
    """Le a configuracao do primeiro lugar que existir.

    A lista de nos nao fica no codigo de proposito: cada instalacao tem a
    sua, e assim da pra versionar o programa sem versionar o inventario.
    """
    candidatos = [os.environ.get('MAGI_CONFIG'),
                  'magi.json',
                  os.path.expanduser('~/.config/magi/config.json')]
    for caminho in candidatos:
        if caminho and os.path.isfile(caminho):
            with open(caminho) as f:
                return json.load(f), caminho
    return None, None


