                title='latencia ate cada unidade (tailnet)', title_style=FOSCO,
                title_justify='left')
    tab.add_column('UNIDADE', style='bold %s' % AMBAR)
    tab.add_column('PING', justify='right')
    tab.add_column('HISTORICO', justify='left')
    tab.add_column('MIN', justify='right')
    tab.add_column('MAX', justify='right')

    for u in unidades:
        hist = list(u.hist_latencia)
        if u.latencia_ms is None:
            tab.add_row(u.rotulo, Text('sem resposta', style=VERMELHO),
                        faisca(hist, 22, VERMELHO), '-', '-')
            continue
        cor = cor_latencia(u.latencia_ms)
        tab.add_row(
            u.rotulo,
            Text('%.0fms' % u.latencia_ms, style=cor),
            faisca(hist, 22, cor),
            '%.0fms' % min(hist, default=u.latencia_ms),
            '%.0fms' % max(hist, default=u.latencia_ms),
        )
    return tab


def estado_tenant(x):
    """Cor unica do tenant, tirada do pior sinal entre site, banco e replica."""
    if x['site'] == 0.0 or not x['db_up']:
        return VERMELHO
    if not x['rep'][0] or not x['rep'][1]:
        return LARANJA_FORTE
    lag = x['rep'][2]
    if lag is not None and lag >= 60:
        return LARANJA_FORTE
    if x['site'] is None or not x['tem_task']:
        return FOSCO
    return VERDE


def largura_terminal(padrao=LARGURA_IDEAL):
    try:
        return os.get_terminal_size().columns
    except OSError:
        return padrao


def _cel_pct(v):
    return Text('-', style=FOSCO) if v is None else \
        Text('%.1f' % v, style=cor_por_valor(v))


def _cel_bytes(v):
    return Text('-', style=FOSCO) if v is None else \
        Text(bytes_h(v), style=AMBAR)


def faixa_sonda(valores, largura=BLOCOS_SONDA):
    """Historico de disponibilidade em blocos, o mais recente a direita.

    Verde respondendo, vermelho sem responder, apagado sem dado. Bloco cheio
    nos dois estados de proposito: uma falha tem de pesar tanto na vista
    quanto o sucesso, senao o olho passa batido.
    """
    t = Text()
    faltam = largura - len(valores)
    if faltam > 0:
        t.append('░' * faltam, style=FOSCO)
    for v in valores[-largura:]:
        # quadrante de baixo a esquerda: deixa folga a direita E acima de
        # cada celula. Com meio-bloco a faixa se separava na horizontal, mas
        # 18 linhas de verde colavam na vertical e o conjunto virava um
        # retangulo. Regua entre as linhas resolveria tambem, mas dobraria a
        # altura da tabela, que nao cabe na janela
        t.append('▖', style=VERDE if v >= 1 else VERMELHO)
    return t


def tabela_tenants(linhas, titulo):
    # rotulo curto e fixo: cortar o nome do servico em 5 letras produzia
    # cabecalho feio ('mariadb' virava 'MARIA'). O nome completo do servico
    # aparece na aba da unidade, no nome da task
    rot_app, rot_db = 'APP', 'DB'
    # expand=False e tabela centralizada: a faixa tem largura fixa, porque e
    # janela de tempo e nao proporcao, entao nao existe coluna elastica para
    # absorver a sobra da largura
    tab = Table(expand=False, border_style=FOSCO, box=None,
                header_style='bold %s' % LARANJA, title=titulo,
                title_style='bold %s' % AMBAR, pad_edge=False, padding=(0, 1))
    tab.add_column('TENANT', style=AMBAR, no_wrap=True, width=13)
    tab.add_column('NO', justify='center', width=3)
    tab.add_column('SITE', justify='center', width=4)
    tab.add_column('ms', justify='right', width=4)
    tab.add_column(rot_app, justify='right', width=5)
    tab.add_column('MEM', justify='right', width=7)
    tab.add_column(rot_db, justify='right', width=5)
    tab.add_column('MEM', justify='right', width=7)
    tab.add_column('CPU', justify='right', width=5)
    tab.add_column('REPL', justify='left', width=8)
    tab.add_column('DISPONIBILIDADE %dmin' % JANELA_SONDA, justify='left',
                   width=max(BLOCOS_SONDA, 19))

    if not linhas:
        tab.add_row(Text('sem dados', style=FOSCO), *[''] * 10)
        return tab

    for x in linhas:
        cor = estado_tenant(x)
        if x['site'] is None:
            site = Text('?', style=FOSCO)
        elif x['site'] == 1.0:
            site = Text('UP', style=VERDE)
        else:
            site = Text('OFF', style=VERMELHO)
        ms = (Text('%d' % (x['latencia'] * 1000), style=AMBAR)
              if x['latencia'] is not None else Text('-', style=FOSCO))
        tem, ok, lag = x['rep']
        if not tem:
            repl = Text('ausente', style=VERMELHO)
        elif not ok:
            repl = Text('%s PARADA' % x['no_rep'], style=VERMELHO)
        elif lag is None:
            repl = Text('%s ok' % x['no_rep'], style=VERDE)
        else:
            cor_lag = (VERDE if lag < 30 else
                       LARANJA_FORTE if lag < 300 else VERMELHO)
            repl = Text('%s %ds' % (x['no_rep'], int(lag)), style=cor_lag)

        tem_cpu = x['app_cpu'] is not None or x['db_cpu'] is not None
        soma = (x['app_cpu'] or 0) + (x['db_cpu'] or 0)
        tab.add_row(
            Text('%s %s' % ('●' if cor == VERDE else '○', x['tenant'][:11]),
                 style=cor),
            Text(x['no'], style=CIANO),
            site, ms,
            _cel_pct(x['app_cpu']), _cel_bytes(x['app_mem']),
            _cel_pct(x['db_cpu']), _cel_bytes(x['db_mem']),
            _cel_pct(soma if tem_cpu else None),
            repl,
            faixa_sonda(x.get('hist', [])),
        )
    return tab


def painel_resumo_cluster(cluster, unidades):
    r = cluster.resumo()
    with cluster.lock:
        erro, quando = cluster.erro, cluster.atualizado
    tasks = sum(1 for u in unidades for c in u.containers if c['swarm'])
    servicos = len({(c['stack'], c['svc']) for u in unidades
                    for c in u.containers if c['swarm']})
    soltos = sum(1 for u in unidades for c in u.containers if not c['swarm'])

    esq, dir_ = [], []
    t = Text()
    t.append('tenants    ', style=FOSCO)
    t.append('%d' % r['total'], style=AMBAR)
    t.append('   no ar ', style=FOSCO)
    inteiro = r['total'] and r['no_ar'] == r['total']
    t.append('%d/%d' % (r['no_ar'], r['total']),
             style='bold %s' % (VERDE if inteiro else VERMELHO))
    esq.append(t)
    t = Text()
    t.append('replicando ', style=FOSCO)
    todas = r['total'] and r['replicando'] == r['total']
    t.append('%d/%d' % (r['replicando'], r['total']),
             style='bold %s' % (VERDE if todas else LARANJA_FORTE))
    t.append('   lag max ', style=FOSCO)
    if r['lag_max'] is None:
        t.append('-', style=FOSCO)
    else:
        t.append('%ds' % int(r['lag_max']),
                 style=VERDE if r['lag_max'] < 30 else LARANJA_FORTE)
    esq.append(t)

    t = Text()
    t.append('servicos   ', style=FOSCO)
    t.append(str(servicos), style=AMBAR)
    t.append('   tasks ', style=FOSCO)
    t.append(str(tasks), style=AMBAR)
    t.append('   soltos ', style=FOSCO)
    t.append(str(soltos), style=AMBAR)
    dir_.append(t)
    t = Text()
    t.append('veredito   ', style=FOSCO)
    if erro:
        t.append(erro.upper(), style='bold %s' % VERMELHO)
    elif r['fora']:
        t.append('FORA DO AR: %s' % ', '.join(r['fora']),
                 style='bold %s' % VERMELHO)
    elif r['sem_replica']:
        t.append('SEM REPLICA: %s' % ', '.join(r['sem_replica']),
                 style='bold %s' % LARANJA_FORTE)
    elif r['total']:
        t.append('CLUSTER INTEGRO', style='bold %s' % VERDE)
    else:
        t.append('COLETANDO', style=FOSCO)
    dir_.append(t)
    if quando:
        t = Text()
        t.append('coleta     ', style=FOSCO)
        t.append(time.strftime('%H:%M:%S', time.localtime(quando)), style=FOSCO)
        dir_.append(t)

    grid = Table.grid(expand=True, padding=(0, 2))
    grid.add_column(ratio=1)
    grid.add_column(ratio=1)
    grid.add_row(Group(*esq), Group(*dir_))
    return Panel(grid, border_style=FOSCO, padding=(0, 1),
                 title='[%s]CLUSTER[/]' % LARANJA, title_align='left')


def aba_cluster(cluster, unidades):
    with cluster.lock:
        linhas = list(cluster.tenants)
    topo = painel_resumo_cluster(cluster, unidades)

    # uma lista so, ordenada por no. Duas tabelas lado a lado mostravam o
    # balanceamento, mas quebravam a leitura: o olho ia e voltava entre as
    # metades. A coluna NO ja agrupa, e a barra de CPU segue em escala comum,
    # entao a comparacao entre nos nao se perde.
    #
    # A barra leva toda a sobra da largura: com teto fixo sobrava um vao morto
    # a direita da tabela em terminal largo.
    corpo = tabela_tenants(sorted(linhas, key=lambda x: (x['no'], x['tenant'])),
                           'TENANTS')
    legenda = Text()
    legenda.append('faixa  ', style=FOSCO)
    legenda.append('▖', style=VERDE)
    legenda.append(' respondendo   ', style=FOSCO)
    legenda.append('▖', style=VERMELHO)
    legenda.append(' sem responder   ', style=FOSCO)
    legenda.append('░', style=FOSCO)
    legenda.append(' sem dado   1 bloco = %d min, o mais recente a direita'
                   % max(1, JANELA_SONDA // BLOCOS_SONDA), style=FOSCO)
    return Group(topo, Text(''), Align.center(corpo), Text(''),
                 Align.center(legenda))


def aba_diagrama(unidades):
    """Diagrama triangular das tres unidades, no estilo da tela do MAGI
    quando o sistema e atacado no anime: cada no e o seu proprio selo, sem
    fingir um voto agregado que o cluster ainda nao tem condicao de emitir.
    Abaixo, dados reais: metricas por unidade e a latencia de verdade desta
    maquina ate cada uma pela tailnet."""
    titulo = Text('DIAGRAMA DE DISPONIBILIDADE', style='bold %s' % LARANJA)

    linhas = [titulo, Text('')]
