def bytes_h(n, sufixo='B'):
    for u in ('', 'K', 'M', 'G', 'T'):
        if abs(n) < 1024:
            return '%.0f%s%s' % (n, u, sufixo) if u == '' else '%.1f%s%s' % (n, u, sufixo)
        n /= 1024.0
    return '%.1fP%s' % (n, sufixo)


def dur_h(seg):
    seg = int(seg)
    d, resto = divmod(seg, 86400)
    h, resto = divmod(resto, 3600)
    m = resto // 60
    if d:
        return '%dd %02dh' % (d, h)
    return '%02dh %02dm' % (h, m)


# nome de task de servico no Swarm: <stack>_<servico>.<slot>.<idtask>
# em servico global o lugar do slot traz o id do no, nao o numero da replica
TASK_SWARM = re.compile(
    r'^(?P<stack>[a-z0-9][a-z0-9-]*)_(?P<svc>[a-z0-9][a-z0-9_-]*?)'
    r'\.(?P<slot>\d+|[a-z0-9]{20,})\.(?P<task>[a-z0-9]{20,})$')


def nome_curto(nome):
    """'loja_app.1.gcfii3yh..' -> ('loja/app', 'loja', 'app', True).

    Container que nao e task de Swarm volta com o nome intacto e swarm=False:
    numa maquina que roda Swarm ainda sobram containers soltos, como replicas
    de banco e exporters.
    """
    m = TASK_SWARM.match(nome)
    if not m:
        return nome, '', '', False
    stack, svc, slot = m.group('stack'), m.group('svc'), m.group('slot')
    marca = '' if slot.isdigit() else '*'
    return '%s/%s%s' % (stack, svc, marca), stack, svc, True


def _e_tenant(container):
    """Um container conta como tenant por prefixo ou por servico do Swarm.

    No Swarm o nome ganha stack e id de task, entao o teste por prefixo deixa
    de casar: loja_app.1.<id> nao comeca com 'app_'. Por isso o servico
    extraido da task tambem vale.
    """
    if PREFIXO_TENANT and container['nome'].startswith(PREFIXO_TENANT):
        return True
    svc = CLUSTER.get('servico_app')
    return bool(svc) and container.get('svc') == svc


class Cluster:
    """Visao por tenant, montada so com consultas ao Prometheus.

    Os nomes de job e de label vem da configuracao porque variam por
    instalacao. Nao usa metrica swarm_*: o dockerd so expoe isso se a
    instalacao ligar metrics-addr, o que exige reiniciar o daemon.
    """

    def __init__(self, unidades):
        self.lock = threading.Lock()
        self.unidades = unidades
        self.tenants = []
        self.erro = ''
        self.atualizado = 0.0
        self.job_banco = CLUSTER.get('job_banco', '')
        self.job_replica = CLUSTER.get('job_replica', '')
        self.job_sonda = CLUSTER.get('job_sonda', '')
        self.l_tenant = CLUSTER.get('label_tenant', 'tenant')
        self.l_box = CLUSTER.get('label_box', 'box')
        self.svc_app = CLUSTER.get('servico_app', '')
        self.svc_banco = CLUSTER.get('servico_banco', '')

    def _sigla(self, caixa):
        for u in self.unidades:
            if caixa and getattr(u, 'caixa', '') == caixa:
                return getattr(u, 'sigla', u.nome[:3])
        return '?'

    def coletar(self):
        if not TEM_CLUSTER:
            return
        prim = prom_query('mysql_up{job="%s"}' % self.job_banco)
        if not prim:
            with self.lock:
                self.erro = 'sem resposta do Prometheus'
            return
        rep_io = rep_sql = rep_lag = []
        if self.job_replica:
            rep_io = prom_query('mysql_slave_status_slave_io_running'
                                '{job="%s"}' % self.job_replica)
            rep_sql = prom_query('mysql_slave_status_slave_sql_running'
                                 '{job="%s"}' % self.job_replica)
            rep_lag = prom_query('mysql_slave_status_seconds_behind_master'
                                 '{job="%s"}' % self.job_replica)
        sonda = atraso = []
        hist = {}
        if self.job_sonda:
            sonda = prom_query('probe_success{job="%s"}' % self.job_sonda)
            atraso = prom_query('probe_duration_seconds{job="%s"}'
                                % self.job_sonda)
            hist = self.historico_sonda()

        def vals(res, chave):
            return {x['metric'].get(chave, '?'): float(x['value'][1])
                    for x in res}

        v_prim = vals(prim, self.l_tenant)
        v_io = vals(rep_io, self.l_tenant)
        v_sql = vals(rep_sql, self.l_tenant)
        v_lag = vals(rep_lag, self.l_tenant)
        # a sonda e por alvo, e nela o tenant costuma vir no proprio instance
        v_sonda = vals(sonda, 'instance')
        v_atraso = vals(atraso, 'instance')
        caixa_prim = {x['metric'].get(self.l_tenant):
                      x['metric'].get(self.l_box, '') for x in prim}
        caixa_rep = {x['metric'].get(self.l_tenant):
                     x['metric'].get(self.l_box, '') for x in rep_io}

        # o consumo vem do que o laco de containers ja coletou, sem consulta
        # nova; sem servico configurado as colunas ficam vazias e a aba ainda
        # serve para site e replica
        uso = {}
        servicos = tuple(x for x in (self.svc_app, self.svc_banco) if x)
        for u in self.unidades:
            with u.lock:
                for c in u.containers:
                    if c['stack'] and servicos and c['svc'] in servicos:
                        uso[(c['stack'], c['svc'])] = c

        linhas = []
        for tenant in sorted(v_prim):
            g = uso.get((tenant, self.svc_app), {}) if self.svc_app else {}
            d = uso.get((tenant, self.svc_banco), {}) if self.svc_banco else {}
            tem_rep = tenant in v_io
            linhas.append({
                'tenant': tenant,
                'no': self._sigla(caixa_prim.get(tenant, '')),
                'no_rep': self._sigla(caixa_rep.get(tenant, '')) if tem_rep else '-',
                'db_up': v_prim.get(tenant, 0.0) >= 1,
                'site': v_sonda.get(tenant),
                'latencia': v_atraso.get(tenant),
                'app_cpu': g.get('cpu'), 'app_mem': g.get('mem'),
                'db_cpu': d.get('cpu'), 'db_mem': d.get('mem'),
                'tem_task': bool(g),
                'hist': hist.get(tenant, []),
                'rep': (tem_rep,
                        v_io.get(tenant, 0.0) >= 1 and v_sql.get(tenant, 0.0) >= 1,
                        v_lag.get(tenant)),
            })
        with self.lock:
            self.tenants = linhas
            self.erro = ''
            self.atualizado = time.time()

    def historico_sonda(self):
        """Faixa de disponibilidade por tenant, um valor por bloco da barra.

        Uma consulta de intervalo para todos os tenants de uma vez, em vez de
        uma por tenant. O passo e a janela dividida pelo numero de blocos,
        entao cada bloco vale JANELA_SONDA / BLOCOS_SONDA de tempo real e a
        faixa anda para a direita conforme o tempo passa.
        """
        passo = max(15, JANELA_SONDA * 60 // BLOCOS_SONDA)
        res = prom_range('probe_success{job="%s"}' % self.job_sonda,
                         minutos=JANELA_SONDA, passo=passo)
        saida = {}
        for serie in res:
            tenant = serie['metric'].get('instance', '')
            if not tenant:
                continue
            valores = []
            for _, v in serie.get('values', [])[-BLOCOS_SONDA:]:
                try:
                    valores.append(float(v))
                except (TypeError, ValueError):
                    pass
            saida[tenant] = valores
        return saida

    def resumo(self):
        with self.lock:
            t = list(self.tenants)
        lags = [x['rep'][2] for x in t if x['rep'][2] is not None]
        return {'total': len(t),
                'no_ar': sum(1 for x in t if x['site'] == 1.0),
                'replicando': sum(1 for x in t if x['rep'][0] and x['rep'][1]),
                'lag_max': max(lags) if lags else None,
                'sem_replica': [x['tenant'] for x in t if not x['rep'][0]],
                'fora': [x['tenant'] for x in t if x['site'] == 0.0]}


def cor_por_valor(pct):
    # vermelho e exclusivo de indisponibilidade total; um disco em 92% e
    # grave mas a maquina esta de pe, entao o topo da escala e laranja forte
    if pct >= 90:
        return LARANJA_FORTE
    if pct >= 70:
        return LARANJA
    return AMBAR


