def http_get(url, timeout=4.0):
    req = urllib.request.Request(url, headers={'User-Agent': 'magi/1.0'})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return r.read().decode('utf-8', 'replace')


def checar_porta(host, porta, timeout=1.5):
    """Teste real de alcance, usado na tela de boot (nao e teatro: se a
    porta nao responde, a checagem falha de verdade)."""
    try:
        with socket.create_connection((host, porta), timeout=timeout):
            return True
    except OSError:
        return False


def prom_query(expr, timeout=6.0):
    url = PROM + '/api/v1/query?' + urllib.parse.urlencode({'query': expr})
    try:
        import json
        return json.loads(http_get(url, timeout))['data']['result']
    except Exception:
        return []


def prom_range(expr, minutos=30, passo=30, timeout=10.0):
    import json
    fim = int(time.time())
    ini = fim - minutos * 60
    url = PROM + '/api/v1/query_range?' + urllib.parse.urlencode(
        {'query': expr, 'start': ini, 'end': fim, 'step': passo})
    try:
        return json.loads(http_get(url, timeout))['data']['result']
    except Exception:
        return []


LINHA = re.compile(r'^([a-zA-Z_:][a-zA-Z0-9_:]*)(\{[^}]*\})?\s+([^\s]+)$')


def parse_metrics(texto):
    """Converte o formato texto do Prometheus em lista de (nome, labels, valor)."""
    saida = []
    for ln in texto.split('\n'):
        if not ln or ln[0] == '#':
            continue
        m = LINHA.match(ln.strip())
        if not m:
            continue
        nome, rot, val = m.group(1), m.group(2) or '', m.group(3)
        try:
            valor = float(val)
        except ValueError:
            continue
        labels = {}
        if rot:
            for par in re.findall(r'(\w+)="([^"]*)"', rot):
                labels[par[0]] = par[1]
        saida.append((nome, labels, valor))
    return saida


def soma(metricas, nome, filtro=None):
    t = 0.0
    for n, lab, v in metricas:
        if n != nome:
            continue
        if filtro and not filtro(lab):
            continue
        t += v
    return t


def primeiro(metricas, nome, filtro=None, padrao=0.0):
    for n, lab, v in metricas:
        if n == nome and (not filtro or filtro(lab)):
            return v
    return padrao


IGNORA_NET = re.compile(r'^(lo|docker|veth|br-|tailscale)')
IGNORA_DISCO = re.compile(r'^(loop|ram|dm-|sr)')


class Unidade:
    """Estado de uma maquina do cluster."""

    def __init__(self, cfg):
        self.__dict__.update(cfg)
        self.lock = threading.Lock()
        self.online = False
        self.erro = ''
        self.cpu = 0.0
        self.mem_pct = 0.0
        self.mem_usada = 0.0
        self.mem_total = 0.0
        self.disco_pct = 0.0
        self.disco_usado = 0.0
        self.disco_total = 0.0
        self.load = (0.0, 0.0, 0.0)
        self.ncpu = 1
        self.uptime = 0.0
        self.net_rx = 0.0
        self.net_tx = 0.0
        self.io_leitura = 0.0
        self.io_escrita = 0.0
        self.latencia_ms = None  # tempo de resposta desta maquina ate a unidade
        self.hist_latencia = deque(maxlen=HISTORICO)
        self.hist_cpu = deque(maxlen=HISTORICO)
        self.hist_mem = deque(maxlen=HISTORICO)
        self.hist_io = deque(maxlen=HISTORICO)
        self.containers = []
        self.anterior = None

    @property
    def rotulo(self):
        return '%s-%s' % (self.nome, self.ord)

    @property
    def estado(self):
        # vermelho fica reservado pra indisponibilidade total (OFFLINE); as
        # duas faixas de alerta abaixo disso usam a mesma escala de
        # cor_por_valor, pro rotulo do estado e o numero que o causou nao
        # aparecerem em cores diferentes
        if not self.online:
            return 'OFFLINE', VERMELHO
        if self.cpu >= 90 or self.mem_pct >= 92 or self.disco_pct >= 90:
            return 'ALERTA', LARANJA_FORTE
        if self.cpu >= 70 or self.mem_pct >= 80 or self.disco_pct >= 80:
            return 'ATENCAO', LARANJA
        return 'NORMAL', VERDE

    def url_node(self):
        q = '&'.join('collect[]=%s' % c for c in COLETORES)
        return 'http://%s:9100/metrics?%s' % (self.ip, q)

    def coletar_host(self):
        # latencia = handshake TCP puro ate a porta do node_exporter, medido
        # a parte da busca das metricas (que carrega ~80KB e enviesaria o
        # numero pra cima). E o "ping" real desta maquina ate a unidade.
        t_ping = time.perf_counter()
        alcancavel = checar_porta(self.ip, 9100, timeout=2.5)
        latencia = (time.perf_counter() - t_ping) * 1000 if alcancavel else None

        try:
            met = parse_metrics(http_get(self.url_node(), timeout=3.5))
        except Exception as e:
            with self.lock:
                self.online = False
                self.erro = type(e).__name__
                self.latencia_ms = latencia
            return

        agora = time.time()
        cpu_total = soma(met, 'node_cpu_seconds_total')
        cpu_idle = soma(met, 'node_cpu_seconds_total',
                        lambda l: l.get('mode') == 'idle')
        ncpu = len({l.get('cpu') for n, l, v in met
                    if n == 'node_cpu_seconds_total'} - {None}) or 1
        rx = soma(met, 'node_network_receive_bytes_total',
                  lambda l: not IGNORA_NET.match(l.get('device', '')))
        tx = soma(met, 'node_network_transmit_bytes_total',
                  lambda l: not IGNORA_NET.match(l.get('device', '')))
        lida = soma(met, 'node_disk_read_bytes_total',
                    lambda l: not IGNORA_DISCO.match(l.get('device', '')))
        escrita = soma(met, 'node_disk_written_bytes_total',
                       lambda l: not IGNORA_DISCO.match(l.get('device', '')))

        mem_total = primeiro(met, 'node_memory_MemTotal_bytes')
        mem_disp = primeiro(met, 'node_memory_MemAvailable_bytes')
        raiz = lambda l: l.get('mountpoint') == '/'
        d_total = primeiro(met, 'node_filesystem_size_bytes', raiz)
        d_livre = primeiro(met, 'node_filesystem_avail_bytes', raiz)
        agora_no = primeiro(met, 'node_time_seconds', padrao=agora)
        boot = primeiro(met, 'node_boot_time_seconds')

        with self.lock:
            ant = self.anterior
            if ant:
                dt = agora - ant['t']
                if dt > 0.2:
                    d_tot = cpu_total - ant['cpu_total']
                    d_idle = cpu_idle - ant['cpu_idle']
                    if d_tot > 0:
                        self.cpu = max(0.0, min(100.0,
                                                (1 - d_idle / d_tot) * 100))
                    self.net_rx = max(0.0, (rx - ant['rx']) / dt)
                    self.net_tx = max(0.0, (tx - ant['tx']) / dt)
                    self.io_leitura = max(0.0, (lida - ant['lida']) / dt)
                    self.io_escrita = max(0.0, (escrita - ant['escrita']) / dt)
                    self.hist_cpu.append(self.cpu)
                    self.hist_mem.append(self.mem_pct)
                    self.hist_io.append(self.io_leitura + self.io_escrita)
            self.anterior = {'t': agora, 'cpu_total': cpu_total,
                             'cpu_idle': cpu_idle, 'rx': rx, 'tx': tx,
                             'lida': lida, 'escrita': escrita}
            self.ncpu = ncpu
            self.mem_total = mem_total
            self.mem_usada = mem_total - mem_disp
            self.mem_pct = (self.mem_usada / mem_total * 100) if mem_total else 0
            self.disco_total = d_total
            self.disco_usado = d_total - d_livre
            self.disco_pct = (self.disco_usado / d_total * 100) if d_total else 0
            self.load = (primeiro(met, 'node_load1'),
                         primeiro(met, 'node_load5'),
                         primeiro(met, 'node_load15'))
            self.uptime = agora_no - boot if boot else 0
            self.latencia_ms = latencia
            if latencia is not None:
                self.hist_latencia.append(latencia)
            self.online = True
            self.erro = ''

    def coletar_containers(self):
        i = self.prom
        # so containers vistos agora. Quando uma task e recriada, a serie da
        # antiga fica no Prometheus por mais 5 min: sem este filtro o tenant
        # aparecia duas vezes e o consumo podia sair da task morta, com 0%
        vivo = ('and on (name) (max by (name) (time() - container_last_seen'
                '{instance="%s",name!=""}) < %d)' % (i, FRESCURA_CONTAINER))
        cpu = prom_query('sum by (name) (rate(container_cpu_usage_seconds_total'
                         '{instance="%s",name!=""}[2m])) * 100 %s' % (i, vivo))
        # uso real, sem o cache reclaimavel do kernel (dentry/inode slab, que
        # o kernel devolve sob pressao e inflava os apps). rss + page cache e
        # o que a aplicacao de fato ocupa; buscados separados pra um container
        # nao sumir se uma metrica faltar
        mem_rss = prom_query('sum by (name) (container_memory_rss'
                             '{instance="%s",name!=""}) %s' % (i, vivo))
        mem_cache = prom_query('sum by (name) (container_memory_cache'
                               '{instance="%s",name!=""}) %s' % (i, vivo))
        rx = prom_query('sum by (name) (rate(container_network_receive_bytes_total'
                        '{instance="%s",name!=""}[2m])) %s' % (i, vivo))
        tx = prom_query('sum by (name) (rate(container_network_transmit_bytes_total'
                        '{instance="%s",name!=""}[2m])) %s' % (i, vivo))

        def mapa(res):
            return {s['metric'].get('name', '?'): float(s['value'][1])
                    for s in res}

        mc, mr, mt = mapa(cpu), mapa(rx), mapa(tx)
        m_rss, m_cache = mapa(mem_rss), mapa(mem_cache)
        mm = {n: m_rss.get(n, 0.0) + m_cache.get(n, 0.0)
              for n in set(m_rss) | set(m_cache)}
        nomes = set(mc) | set(mm)
        lista = []
        for n in nomes:
            curto, stack, svc, swarm = nome_curto(n)
            lista.append({'nome': n, 'curto': curto, 'stack': stack,
                          'svc': svc, 'swarm': swarm,
                          'cpu': mc.get(n, 0.0), 'mem': mm.get(n, 0.0),
                          'rx': mr.get(n, 0.0), 'tx': mt.get(n, 0.0)})
        lista.sort(key=lambda c: (-c['cpu'], -c['mem']))
        with self.lock:
            self.containers = lista

    def semear_historico(self):
        """Preenche o grafico com o historico do Prometheus ao abrir."""
        r = prom_range('(1 - avg(rate(node_cpu_seconds_total'
                       '{instance="%s",mode="idle"}[2m]))) * 100' % self.prom)
        if r:
            with self.lock:
                for _, v in r[0]['values'][-HISTORICO:]:
                    try:
                        self.hist_cpu.append(float(v))
                    except ValueError:
                        pass
        r = prom_range('(1 - node_memory_MemAvailable_bytes{instance="%s"} / '
                       'node_memory_MemTotal_bytes{instance="%s"}) * 100'
                       % (self.prom, self.prom))
        if r:
            with self.lock:
                for _, v in r[0]['values'][-HISTORICO:]:
                    try:
                        self.hist_mem.append(float(v))
                    except ValueError:
                        pass


