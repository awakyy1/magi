# ------------------------------------------------------------------- loop ---


def laco_host(unidades, parar):
    """Coleta as unidades em paralelo: o ciclo dura o tempo da mais lenta."""
    while not parar.is_set():
        threads = [threading.Thread(target=u.coletar_host, daemon=True)
                   for u in unidades]
        for t in threads:
            t.start()
        for t in threads:
            t.join(timeout=4.0)
        parar.wait(INTERVALO_HOST)


def _tenta(fn):
    try:
        fn()
    except Exception:
        pass


def laco_containers(unidades, cluster, parar):
    while not parar.is_set():
        threads = [threading.Thread(target=_tenta, args=(u.coletar_containers,),
                                    daemon=True) for u in unidades]
        for t in threads:
            t.start()
        for t in threads:
            t.join(timeout=8.0)
        _tenta(cluster.coletar)
        parar.wait(INTERVALO_CONTAINER)


def ler_tecla():
    if select.select([sys.stdin], [], [], 0)[0]:
        c = sys.stdin.read(1)
        if c == '\x1b':
            seq = sys.stdin.read(2) if select.select([sys.stdin], [], [], 0.01)[0] else ''
            return {'[C': 'direita', '[D': 'esquerda'}.get(seq, 'esc')
        return c
    return None


def ajustar_janela(console):
    """Pede ao terminal pra crescer ate o tamanho em que o painel cabe.

    Manda a sequencia CSI 8 (a mesma que o `resize` do xterm usa). E uma
    melhoria oportunista, nao uma garantia: varios emuladores ignoram esse
    pedido por seguranca, e dentro de tmux ou screen ela teria que ser
    reempacotada pra chegar no terminal de verdade — por isso esses casos
    saem fora antes de escrever qualquer coisa, pra nao vazar lixo na tela.

    So aumenta, nunca encolhe: diminuir a janela de alguem que ja deixou
    ela grande seria pior do que nao fazer nada. Da pra desligar com
    MAGI_SEM_RESIZE=1.
    """
    if os.environ.get('MAGI_SEM_RESIZE') or not sys.stdout.isatty():
        return
    if os.environ.get('TMUX') or os.environ.get('STY'):
        return
    larg, alt = console.size.width, console.size.height
    if larg >= LARGURA_IDEAL and alt >= ALTURA_IDEAL:
        return
    sys.stdout.write('\x1b[8;%d;%dt' % (max(alt, ALTURA_IDEAL),
                                        max(larg, LARGURA_IDEAL)))
    sys.stdout.flush()
    time.sleep(0.3)   # o terminal precisa de um instante pra aplicar


def tela_boot(console, unidades):
    """Sequencia de inicializacao com checagem real de alcance de cada
    unidade e do Prometheus, antes de entrar no dashboard."""
    console.clear()
    # escolhe o maior logo que cabe na janela real. O resize (CSI 8) e
    # ignorado por varios terminais (kitty, alacritty, foot), entao nao da pra
    # contar com ele: o grande pede ~38 linhas de tela, o medio ~29, e ambos
    # tem os arcos concentricos. So abaixo disso cai na marca curta sem arcos.
    h = console.size.height
    if h >= 38:
        arte = emblema_grande()
    elif h >= 29:
        arte = emblema_medio()
    else:
        arte = emblema()
    console.print(Align.center(arte))
    console.print()
    console.print(Align.center(
        Text('INICIALIZANDO SISTEMA MAGI', style='bold %s' % LARANJA)))
    console.print(Align.center(Text('起動シーケンス', style=FOSCO)))
    console.print()

    for u in unidades:
        ok = checar_porta(u.ip, 9100)
        t = Text()
        t.append('  > unidade %-22s ' % u.rotulo, style=FOSCO)
        t.append('ONLINE' if ok else 'SEM RESPOSTA',
                 style='bold %s' % (VERDE if ok else VERMELHO))
        console.print(t)
        time.sleep(0.15)

    host_prom = urllib.parse.urlparse(PROM).hostname
    porta_prom = urllib.parse.urlparse(PROM).port or 9090
    prom_ok = checar_porta(host_prom, porta_prom) if host_prom else False
    t = Text()
    t.append('  > prometheus %-19s ' % ('(%s)' % host_prom), style=FOSCO)
    t.append('ONLINE' if prom_ok else 'SEM RESPOSTA',
             style='bold %s' % (VERDE if prom_ok else VERMELHO))
    console.print(t)
    time.sleep(0.15)
    console.print()
    console.print(Align.center(Text('carregando historico do Prometheus...', style=FOSCO)))


def main():
    console = Console()
    unidades = [Unidade(c) for c in UNIDADES]
    cluster = Cluster(unidades)

    # antes do boot, nao depois: assim o logo e a checagem ja aparecem na
    # geometria final e nao ha um salto de tamanho ao entrar no painel
    ajustar_janela(console)
    tela_boot(console, unidades)
    threads = [threading.Thread(target=_tenta, args=(u.semear_historico,),
                                daemon=True) for u in unidades]
    for t in threads:
        t.start()
    for t in threads:
        t.join(timeout=12.0)

    console.print(Align.center(
        Text('SISTEMA MAGI: PRONTO', style='bold %s' % VERDE)))
    time.sleep(0.4)

    parar = threading.Event()
    threading.Thread(target=laco_host, args=(unidades, parar), daemon=True).start()
    threading.Thread(target=laco_containers, args=(unidades, cluster, parar),
                     daemon=True).start()

    aba = 0
    # GERAL + uma por unidade + DIAGRAMA, e CLUSTER so se houver config
    total_abas = 2 + len(unidades) + (1 if TEM_CLUSTER else 0)
    fd = sys.stdin.fileno()
    antigo = termios.tcgetattr(fd)
    try:
        tty.setcbreak(fd)
        layout = Layout()
        layout.split_column(
            Layout(name='topo', size=3),
            Layout(name='corpo'),
            Layout(name='base', size=1),
        )
        with Live(layout, console=console, screen=True, refresh_per_second=4,
                  transient=False):
            while True:
                tecla = ler_tecla()
                if tecla:
                    if tecla in ('q', 'Q', '\x03'):
                        break
                    if tecla.isdigit():
                        idx = int(tecla) - 1
                        if 0 <= idx < total_abas:
                            aba = idx
                    elif tecla == '\t' or tecla == 'direita':
                        aba = (aba + 1) % total_abas
                    elif tecla == 'esquerda':
                        aba = (aba - 1) % total_abas
                    elif tecla in ('r', 'R'):
                        for u in unidades:
                            _tenta(u.coletar_containers)
                        _tenta(cluster.coletar)

                layout['topo'].update(cabecalho(aba, unidades))
                if aba == 0:
                    layout['corpo'].update(aba_geral(unidades))
                elif TEM_CLUSTER and aba == total_abas - 1:
                    layout['corpo'].update(aba_cluster(cluster, unidades))
                elif aba == 1 + len(unidades):
                    layout['corpo'].update(aba_diagrama(unidades))
                else:
                    layout['corpo'].update(
                        aba_unidade(unidades[aba - 1]))
                layout['base'].update(rodape())
                time.sleep(0.1)
    finally:
        parar.set()
        termios.tcsetattr(fd, termios.TCSADRAIN, antigo)
    console.print('[%s]MAGI SYSTEM encerrado.[/]' % FOSCO)


if __name__ == '__main__':
    try:
        main()
    except KeyboardInterrupt:
        pass
