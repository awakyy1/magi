def _logo(marca, arcos=()):
    """Compoe as duas camadas: a marca por cima, o arco onde ela nao pinta."""
    linhas = []
    for i in range(max(len(marca), len(arcos))):
        m = marca[i] if i < len(marca) else ''
        a = arcos[i] if i < len(arcos) else ''
        t = Text()
        for j in range(max(len(m), len(a))):
            cm = m[j] if j < len(m) else ' '
            ca = a[j] if j < len(a) else ' '
            if cm != ' ':
                t.append(cm, style=LARANJA)
            elif ca != ' ':
                t.append(ca, style=VERDE_ARCO)
            else:
                t.append(' ')
        linhas.append(t)
    return Group(*linhas)


