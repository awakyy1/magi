# preenchidos com o nome vazado em preto, cantos chanfrados apontando pro
# centro, e MAGI no meio. A cor do bloco e o estado da unidade, entao a tela
# inteira muda de cor junto — que e o efeito do "ALL GREEN" do original.
#
# O chanfro usa bloco de tres quadrantes e nao triangulo geometrico: o
# triangulo nao preenche a celula na maioria das fontes e a diagonal sai
# pontilhada, enquanto o quadrante fecha solido.

CHANFRO = {'tl': '\u259f', 'tr': '\u2599', 'bl': '\u259c', 'br': '\u259b'}


def _tela(largura, altura):
    """Grade de caracteres com cor de frente e de fundo por celula."""
    return ([[' '] * largura for _ in range(altura)],
            [[None] * largura for _ in range(altura)],
            [[None] * largura for _ in range(altura)])


def _bloco(tela, r0, c0, largura, altura, linhas, cor, cortes=(), passo=1):
    """Bloco preenchido com o texto vazado, cantos chanfrados.

    `passo` e quantas colunas o chanfro anda por linha. Com 1 a escada sai
    continua, um degrau por linha; com 2 o degrau fica com duas colunas e
    o corte parece grosseiro, porque o bisel ocupa so a primeira delas.
    """
    g, fg, bg = tela
    k = dict(cortes)
    tl, tr = k.get('tl', 0), k.get('tr', 0)
    bl, br = k.get('bl', 0), k.get('br', 0)

    for i in range(altura):
        for j in range(largura):
            diag, vazio = None, False
            de_baixo = altura - 1 - i
            # corte = quantas colunas somem nesta linha. Zero significa
            # linha cheia: pintar o bisel ai deixava uma lasca solta na
            # borda, que era o que fazia o bloco parecer serrilhado.
            for lado, ativo, corte in (
                    ('tl', i < tl, (tl - 1 - i) * passo),
                    ('bl', de_baixo < bl, (bl - 1 - de_baixo) * passo),
                    ('tr', i < tr, (tr - 1 - i) * passo),
                    ('br', de_baixo < br, (br - 1 - de_baixo) * passo)):
                if not ativo or corte <= 0:
                    continue
                if lado in ('tl', 'bl'):
                    if j < corte:
                        vazio = True
                    elif j == corte:
                        diag = CHANFRO[lado]
                else:
                    lim = largura - 1 - corte
                    if j > lim:
                        vazio = True
                    elif j == lim:
                        diag = CHANFRO[lado]

            r, c = r0 + i, c0 + j
            if diag:
                g[r][c], fg[r][c] = diag, cor
            elif not vazio:
                g[r][c], bg[r][c] = ' ', cor

    # o texto centraliza no trecho que a linha realmente tem preenchido, e
    # nao no retangulo nominal: nas linhas chanfradas o bloco e mais
    # estreito, e centralizar pelo nominal joga a frase por cima do bisel
    # escolhe a altura do texto onde o bloco e mais largo, em vez de
    # centralizar sempre: com chanfro em cima o texto desce, com chanfro
    # embaixo ele sobe, e nenhuma linha fica espremida contra o bisel
    def vao_em(linha):
        cheias = [j for j in range(largura) if bg[linha][c0 + j] == cor]
        return (cheias[-1] - cheias[0] + 1) if cheias else 0

    meio = max(0, (altura - len(linhas)) // 2)
    opcoes = range(0, altura - len(linhas) + 1) if altura >= len(linhas) else [0]
    topo = r0 + max(opcoes, key=lambda o: (
        min(vao_em(r0 + o + n) for n in range(len(linhas))), -abs(o - meio)))

    for n_linha, texto in enumerate(linhas):
        linha = topo + n_linha
        cheias = [c0 + j for j in range(largura) if bg[linha][c0 + j] == cor]
        if not cheias:
            continue
        esq, dir_ = cheias[0], cheias[-1]
        vao = dir_ - esq + 1
        texto = texto[:vao]
        ini = esq + (vao - len(texto)) // 2
        for n, ch in enumerate(texto):
            g[linha][ini + n] = ch
            fg[linha][ini + n] = PRETO


def _liga_blocos(tela, r, c, comp, cor, vertical=False):
    g, _fg, bg = tela
    for i in range(comp):
        rr, cc = (r + i, c) if vertical else (r, c + i)
        g[rr][cc], bg[rr][cc] = ' ', cor


def _rotulo(tela, r, c, texto, cor):
    # limpa o fundo tambem: sem isso o texto cai por cima de uma ligacao e
    # sai laranja sobre laranja, ou seja, invisivel
    g, fg, bg = tela
    for i, ch in enumerate(texto):
        g[r][c + i], fg[r][c + i], bg[r][c + i] = ch, cor, None


def _desenha_tela(tela):
    g, fg, bg = tela
    linhas = []
    for r in range(len(g)):
        t = Text()
        for c in range(len(g[0])):
            estilo = fg[r][c] or ''
            if bg[r][c]:
                estilo = ('%s on %s' % (estilo, bg[r][c])).strip()
            t.append(g[r][c], style=estilo or None)
        linhas.append(t)
    return Group(*linhas)


def _ficha_unidade(u):
    """As tres linhas que vao dentro do bloco: quem e, o que esta pegando,
    e o que carrega. A segunda linha e o gargalo — o recurso mais apertado
    e o quanto ele esta — pra tela dizer o que esta causando o problema, e
    nao so que ha um."""
    if not u.online:
        return [u.rotulo, 'SEM RESPOSTA', u.ip]
    estado = u.estado[0]
    recurso, valor = gargalo(u)
    tenants = sum(1 for c in u.containers if _e_tenant(c))
    return [u.rotulo,
            '%s \u00b7 %s %.0f%%' % (estado, recurso, valor),
            '%d ctn \u00b7 %d ten \u00b7 %s' % (len(u.containers), tenants,
                                            dur_h(u.uptime))]


def painel_unidades(unidades):
    """As tres unidades em triangulo em volta do centro, no estilo da tela
    do MAGI: bloco preenchido, texto vazado, chanfro apontando pro meio."""
    por_nome = {u.nome: u for u in unidades}

    def peca(nome):
        u = por_nome.get(nome)
        if u is None:
            return [nome, '-', '-'], FOSCO
        return _ficha_unidade(u), u.estado[1]

    # a tela tem a largura exata do desenho, senao Align.center centraliza
    # a moldura e o conjunto fica deslocado dentro dela
    tela = _tela(64, 16)

    linhas, cor = peca('BALTHASAR')
    _bloco(tela, 0, 17, 30, 6, linhas, cor, cortes=(('bl', 4), ('br', 4)))
    linhas, cor = peca('CASPER')
    _bloco(tela, 9, 0, 30, 7, linhas, cor, cortes=(('tr', 5),))
    linhas, cor = peca('MELCHIOR')
    _bloco(tela, 9, 34, 30, 7, linhas, cor, cortes=(('tl', 5),))

    # as barras encostam onde o chanfro de fato comeca, nao na borda nominal
    _liga_blocos(tela, 6, 29, 6, LARANJA)      # base de BALTHASAR ao centro
    _liga_blocos(tela, 8, 24, 4, LARANJA)      # CASPER ao centro
    _liga_blocos(tela, 8, 36, 4, LARANJA)      # centro a MELCHIOR
    _rotulo(tela, 7, 28, 'M A G I', LARANJA_FORTE)
    return _desenha_tela(tela)


def barra(pct, largura=18):
    pct = max(0.0, min(100.0, pct))
    cheio = int(round(pct / 100 * largura))
    cor = cor_por_valor(pct)
    t = Text()
    t.append('█' * cheio, style=cor)
    t.append('░' * (largura - cheio), style=FOSCO)
    return t


def faisca(valores, largura=28, cor=AMBAR, teto=None):
    """Grafico de linha em blocos.

    teto=100 desenha em escala absoluta, entao 30% aparece como bloco baixo.
    teto=None escala pelo proprio pico, para grandezas sem limite natural (IO).
    Sem escala absoluta, um valor estavel virava barra cheia e parecia 100%.

    Duas correcoes em cima disso: (1) com teto fixo e utilizacao baixa (CPU a
    1%, por exemplo), o arredondamento linear jogava tudo pro nivel 0, que e
    espaco em branco — o grafico sumia. Por isso usa raiz quadrada quando ha
    teto absoluto: comprime a escala pra utilizacao baixa ainda aparecer, sem
    fingir que esta alta. (2) sem teto, uma folga de 30% sobre o pico evita
    que a linha fique sempre "no talo" (virando uma barra solida comprida).
    Em ambos os casos, valor > 0 nunca renderiza como bloco vazio.
    """
    if not valores:
        return Text('░' * largura, style=FOSCO)
    dados = list(valores)[-largura:]
    comprime = teto is not None
    escala = float(teto) if teto else (max(dados) or 1.0) * 1.3
    if escala <= 0:
        escala = 1.0
    t = Text()
    if len(dados) < largura:
        t.append('░' * (largura - len(dados)), style=FOSCO)
    for v in dados:
        if v <= 0:
            idx = 0
        else:
            frac = min(1.0, v / escala)
            if comprime:
                frac = frac ** 0.5
            idx = max(1, min(8, round(frac * 8)))
        t.append(BLOCOS[idx], style=cor)
    return t


def linha_metrica(rotulo, valor_txt, pct, spark=None, largura_barra=16):
    t = Text()
    t.append('%-5s ' % rotulo, style=FOSCO)
    t.append_text(barra(pct, largura_barra))
    t.append(' %7s' % valor_txt, style=cor_por_valor(pct))
    if spark is not None:
        t.append('  ')
        t.append_text(spark)
    return t


