def painel_unidade(u, larg_barra=12, larg_g=24):
    with u.lock:
        estado, cor_estado = u.estado
        linhas = []
        cab = Text()
        cab.append('%s ' % u.rotulo, style='bold %s' % AMBAR)
        cab.append('・ ', style=FOSCO)
        cab.append(estado, style='bold %s' % cor_estado)
        linhas.append(cab)
        sub = Text()
        sub.append(u.papel, style=FOSCO)
        linhas.append(sub)
        linhas.append(Text(''))

        if not u.online:
            linhas.append(Text('  SEM RESPOSTA  %s' % u.erro, style=VERMELHO))
            linhas.append(Text('  %s' % u.ip, style=FOSCO))
            return Panel(Group(*linhas), border_style=VERMELHO,
                         title='[%s]OFFLINE[/]' % VERMELHO, padding=(0, 1))

        # mostradores: barra e valor, sem grafico grudado, para caber e nao apertar
        linhas.append(linha_metrica('CPU', '%5.1f%%' % u.cpu, u.cpu, None, larg_barra))
        linhas.append(linha_metrica('MEM', '%5.1f%%' % u.mem_pct, u.mem_pct, None, larg_barra))
        linhas.append(linha_metrica('DSK', '%5.1f%%' % u.disco_pct, u.disco_pct, None, larg_barra))
        linhas.append(Text(''))

        # graficos em escala ABSOLUTA de 0 a 100%: valor estavel fica baixo,
        # e nao cheio como acontecia quando a escala era o proprio pico
        g = Text()
        g.append('cpu   ', style=FOSCO)
        g.append_text(faisca(u.hist_cpu, larg_g, cor_por_valor(u.cpu), teto=100))
        linhas.append(g)
        g = Text()
        g.append('mem   ', style=FOSCO)
        g.append_text(faisca(u.hist_mem, larg_g, cor_por_valor(u.mem_pct), teto=100))
        linhas.append(g)
        g = Text()
        pico_io = max(u.hist_io) if u.hist_io else 0.0
        g.append('io    ', style=FOSCO)
        g.append_text(faisca(u.hist_io, larg_g, LARANJA))
        linhas.append(g)
        esc = Text()
        # rotulo curto de proposito: com "io pico" a linha passa de 30
        # colunas quando o pico tem tres digitos, e quebra no painel de tres
        esc.append('      0-100%%  pico %s/s' % bytes_h(pico_io), style=FOSCO)
        linhas.append(esc)
        linhas.append(Text(''))

        det = Text()
        det.append('  mem  ', style=FOSCO)
        det.append('%s / %s' % (bytes_h(u.mem_usada), bytes_h(u.mem_total)),
                   style=AMBAR)
        linhas.append(det)
        det = Text()
        det.append('  dsk  ', style=FOSCO)
        det.append('%s / %s' % (bytes_h(u.disco_usado), bytes_h(u.disco_total)),
                   style=AMBAR)
        linhas.append(det)
        det = Text()
        det.append('  net  ', style=FOSCO)
        det.append('↓%s/s ' % bytes_h(u.net_rx), style=CIANO)
        det.append('↑%s/s' % bytes_h(u.net_tx), style=CIANO)
        linhas.append(det)
        det = Text()
        det.append('  io   ', style=FOSCO)
        det.append('r %s/s ' % bytes_h(u.io_leitura), style=LARANJA)
        det.append('w %s/s' % bytes_h(u.io_escrita), style=LARANJA)
        linhas.append(det)
        det = Text()
        det.append('  load ', style=FOSCO)
        det.append('%.2f %.2f %.2f' % u.load, style=AMBAR)
        det.append('  (%d cpu)' % u.ncpu, style=FOSCO)
        linhas.append(det)
        det = Text()
        det.append('  up   ', style=FOSCO)
        det.append(dur_h(u.uptime), style=AMBAR)
        det.append('   ctn ', style=FOSCO)
        det.append(str(len(u.containers)), style=AMBAR)
        linhas.append(det)

    return Panel(Group(*linhas), border_style=cor_estado,
                 title='[%s]%s[/]' % (cor_estado, u.ip), title_align='right',
                 padding=(0, 1))


TETO_MEM = 0.85   # acima disso a unidade e tratada como sem folga de memoria


def _media(seq):
    seq = list(seq)
    return (sum(seq) / len(seq)) if seq else None


def cpu_estavel(u):
    """CPU pela media do historico, nao pela amostra do segundo: a leitura
    instantanea oscila demais e faria o veredito trocar de unidade a cada
    quadro, o que nao serve pra decidir nada."""
    med = _media(u.hist_cpu)
    return u.cpu if med is None else med


def gargalo(u):
    """Recurso mais apertado da unidade, e quanto ele esta. E ele que
    limita o que ainda cabe ali, entao e por ele que a unidade e julgada."""
    return max((('cpu', cpu_estavel(u)), ('mem', u.mem_pct), ('dsk', u.disco_pct)),
               key=lambda par: par[1])


def pegada_tenant(unidades):
    """Memoria media de um tenant, medida pelos que ja rodam no cluster.

    E estimativa, nao medida de um tenant especifico: serve pra dar ordem
    de grandeza de quantos ainda cabem. Retorna None quando nao ha tenant
    nenhum reportado pra servir de base.
    """
    mems = [c['mem'] for u in unidades for c in u.containers
            if _e_tenant(c) and c['mem'] > 0]
    return (sum(mems) / len(mems)) if mems else None


def cabem_tenants(u, pegada):
    """Quantos tenants ainda cabem na unidade pela memoria, respeitando o
    teto de seguranca. So considera memoria — disco e CPU entram no
    veredito pela via do gargalo()."""
    if not pegada or not u.mem_total:
        return None
    folga = u.mem_total * TETO_MEM - u.mem_usada
    return max(0, int(folga // pegada))


def aba_geral(unidades):
    tab = Table.grid(expand=True, padding=(0, 1))
    for _ in unidades:
        tab.add_column(ratio=1)
    tab.add_row(*[painel_unidade(u) for u in unidades])

    vivos = [u for u in unidades if u.online]
    online = len(vivos)
    cpu_med = sum(u.cpu for u in vivos) / max(1, online)
    ctn = sum(len(u.containers) for u in unidades)

    # topo: logo a esquerda, ficha do sistema a direita, para nao gastar altura
    topo = Table.grid(expand=True, padding=(0, 2))
    topo.add_column(width=26)   # o logo tem 24 colunas; o resto e respiro
    topo.add_column(ratio=1)

    ficha = []
    f = Text()
    f.append('SISTEMA MAGI', style='bold %s' % LARANJA)
    f.append('   マギ システム', style=FOSCO)
    ficha.append(f)
    ficha.append(Text(''))
    f = Text()
    f.append('unidades   ', style=FOSCO)
    f.append('%d de %d respondendo' % (online, len(unidades)),
             style='bold %s' % (VERDE if online == len(unidades) else VERMELHO))
    ficha.append(f)
    f = Text()
    f.append('carga      ', style=FOSCO)
    f.append('%.1f%% em media' % cpu_med, style=cor_por_valor(cpu_med))
    ficha.append(f)
    f = Text()
    f.append('containers ', style=FOSCO)
    f.append(str(ctn), style=AMBAR)
    f.append('   tenants ', style=FOSCO)
    f.append(str(sum(1 for u in unidades for c in u.containers
                     if _e_tenant(c))), style=AMBAR)
    ficha.append(f)
    # quem carrega o cluster hoje
    f = Text()
    f.append('concentra  ', style=FOSCO)
    if vivos and ctn:
        mais = max(vivos, key=lambda u: len(u.containers))
        n = len(mais.containers)
        f.append(mais.rotulo, style='bold %s' % AMBAR)
        f.append(' · %d de %d containers (%.0f%%)' % (n, ctn, n / ctn * 100),
                 style=FOSCO)
    else:
        f.append('sem containers reportados', style=FOSCO)
    ficha.append(f)

    # o que estoura primeiro
    f = Text()
    f.append('risco      ', style=FOSCO)
    if not vivos:
        f.append('todas as unidades fora do ar', style='bold %s' % VERMELHO)
    else:
        pior = max(vivos, key=lambda u: gargalo(u)[1])
        rec, val = gargalo(pior)
        if val >= 80:
            f.append(pior.rotulo, style='bold %s' % AMBAR)
            f.append(' · %s %.0f%%' % (rec, val), style=LARANJA)
            f.append(', nao comporta novo tenant' if val >= 90
                     else ', perto do limite', style=FOSCO)
        else:
            f.append('nenhuma unidade perto do limite', style=VERDE)
    ficha.append(f)

    # onde cabe o proximo tenant
    f = Text()
    f.append('veredito   ', style=FOSCO)
    if not vivos:
        f.append('SISTEMA INOPERANTE', style='bold %s' % VERMELHO)
    else:
        apta = min(vivos, key=lambda u: gargalo(u)[1])
        rec, val = gargalo(apta)
        cabem = cabem_tenants(apta, pegada_tenant(unidades))
        if val >= 90:
            f.append('NENHUMA UNIDADE COM FOLGA', style='bold %s' % LARANJA)
        else:
            f.append(apta.rotulo, style='bold %s' % VERDE)
            if cabem is None:
                f.append(' apta · limite %s %.0f%%' % (rec, val), style=FOSCO)
            elif cabem == 0:
                f.append(' apta, mas sem folga de memoria', style=FOSCO)
            elif rec != 'mem' and val >= 70:
                # a conta e por memoria; se o aperto vem de outro recurso,
                # dizer so "cabem N" enganaria
                f.append(' apta · ~%d pela mem, %s ja em %.0f%%'
                         % (cabem, rec, val), style=FOSCO)
            else:
                f.append(' apta · cabem ~%d tenants pela memoria' % cabem,
                         style=FOSCO)
    ficha.append(f)

    topo.add_row(emblema(), Group(*ficha))

    return Group(Panel(topo, border_style=FOSCO, padding=(0, 1)), Text(''), tab)


def aba_unidade(u):
    # grafico do mesmo tamanho das barras de CPU/MEM/DSK acima, em vez de
    # esticar pra quase a largura toda do terminal
    larg_barra = 28
    larg_g = larg_barra

    # painel_unidade pega o lock por conta propria; threading.Lock nao e
    # reentrante, entao nao da para chamar aqui de dentro de um "with u.lock".
    cabecalho = painel_unidade(u, larg_barra=larg_barra, larg_g=larg_g)
    with u.lock:
        containers = list(u.containers)
        online = u.online

    tab = Table(expand=True, border_style=FOSCO, header_style='bold %s' % LARANJA,
                title_style='bold %s' % AMBAR)
    tab.add_column('TASK / CONTAINER', style=AMBAR, no_wrap=True)
    tab.add_column('CPU%', justify='right', width=8)
    tab.add_column('MEM', justify='right', width=10)
    tab.add_column('USO', justify='left', width=14)
    tab.add_column('RX/s', justify='right', width=10)
    tab.add_column('TX/s', justify='right', width=10)

    if not containers:
        if u.prom in SEM_CADVISOR:
            motivo = 'sem cAdvisor nesta unidade, nao ha metrica de container'
        elif not online:
            motivo = 'unidade offline'
        else:
            motivo = 'sem dados do Prometheus'
        tab.add_row(Text(motivo, style=FOSCO), '-', '-', '', '-', '-')
    else:
        pico = max((c['mem'] for c in containers), default=1) or 1
        for c in containers:
            pct_cpu = c['cpu']
            tab.add_row(
                Text(c['curto'], style=AMBAR if c['swarm'] else FOSCO),
                Text('%.1f' % pct_cpu, style=cor_por_valor(pct_cpu)),
                Text(bytes_h(c['mem']), style=AMBAR),
                barra(c['mem'] / pico * 100, 12),
                Text(bytes_h(c['rx']) if c['rx'] else '-', style=CIANO),
                Text(bytes_h(c['tx']) if c['tx'] else '-', style=CIANO),
            )
    legenda = Text()
    n_swarm = sum(1 for c in containers if c['swarm'])
    if n_swarm:
        legenda.append('  tasks de swarm ', style=FOSCO)
        legenda.append(str(n_swarm), style=AMBAR)
        legenda.append('   containers soltos ', style=FOSCO)
        legenda.append(str(len(containers) - n_swarm), style=AMBAR)
        legenda.append('   * = servico global', style=FOSCO)
    return Group(cabecalho, Text(''), tab, legenda)


def cor_latencia(ms):
    if ms is None:
        return VERMELHO
    if ms < 50:
        return VERDE
    if ms < 150:
        return AMBAR
    return LARANJA


